var controller=new ScrollMagic.Controller();let scrollOffset;if(window.innerWidth<1000){scrollOffset=103;}else{scrollOffset=83;}
new ScrollMagic.Scene({duration:0,offset:scrollOffset,triggerHook:0,reverse:true}).setPin('#my-sticky-element').addTo(controller);if(window.innerWidth>1000){new ScrollMagic.Scene({triggerElement:"#toc",duration:$('#content').height(),offset:-150,triggerHook:0,reverse:true}).setPin('#toc').addTo(controller);}